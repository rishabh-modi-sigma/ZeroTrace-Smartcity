import shap
import numpy as np

# Create SHAP explainer
explainer = shap.TreeExplainer(xgb_model)

# Calculate SHAP values
shap_values = explainer.shap_values(x_test_scaled)

# Explain first test sample
idx = 0

# Check SHAP output format
print("SHAP shape:", np.array(shap_values).shape)
print("Classes:", le.classes_)

# Select class to explain
class_idx = 0

# Force plot
shap.initjs()

shap.force_plot(
    explainer.expected_value[class_idx],
    shap_values[idx, :, class_idx],
    x_test_scaled.iloc[idx]
)





import joblib

# Save trained XGBoost model
joblib.dump(xgb_model, "emission_model.pkl")

# Save fitted scaler
joblib.dump(scaler, "scaler.pkl")

# Save exact feature column order
joblib.dump(list(x_train.columns), "model_columns.pkl")

print("Model, scaler, and column list saved successfully.")









